# =============================================================================
# 通用后台管理系统（admin）—— Git 忽略规则
# 目录结构：README.md / sql/admin.sql / admin-backend（Maven）/ admin-front（Vite）
# =============================================================================

# ---------------------------------------------------------------- 构建产物
# Maven
target/
*.class
# 但保留 Maven Wrapper（如果将来加上）
!.mvn/wrapper/maven-wrapper.jar

# Vite
dist/
admin-front/dist/
.vite/
admin-front/.vite/

# ---------------------------------------------------------------- 依赖
node_modules/
admin-front/node_modules/

# ---------------------------------------------------------------- 日志与运行时
logs/
admin-backend/logs/
admin-backend/admin-boot/logs/
*.log
*.log.*

# ---------------------------------------------------------------- IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
*.swp

# ---------------------------------------------------------------- 操作系统
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 本地环境变量
# .env / .env.development / .env.production 属于工程配置，需要提交；
# 只忽略本机覆盖文件。
.env.local
.env.*.local

# ---------------------------------------------------------------- 其它包管理器
# 本工程统一用 pnpm，忽略其它包管理器生成的锁文件
package-lock.json
yarn.lock

# ---------------------------------------------------------------- 临时文件
*.tmp
*.bak
*.orig
*.rej
